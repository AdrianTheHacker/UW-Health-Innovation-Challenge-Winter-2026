import streamlit as st
import hashlib

st.set_page_config(page_title="Login Page", page_icon="🔐")
st.title("🔐 Login Page")

# --- Helper function for hashing ---
def hash_id(user_id: str) -> str:
    return hashlib.sha256(user_id.encode()).hexdigest()

# --- Encrypted user database (hashed IDs) ---
user_data = {
    hash_id("001"): "Alice",
    hash_id("002"): "Bob",
    hash_id("003"): "Charlie",
    hash_id("004"): "Diana",
    hash_id("005"): "Ethan",
    hash_id("006"): "Fiona",
    hash_id("007"): "George",
    hash_id("008"): "Hannah",
    hash_id("009"): "Ivan",
}

# --- Input ---
user_id_input = st.text_input("Enter User ID (001–009):", type="password")

# --- Login logic ---
if st.button("Login"):
    hashed_input = hash_id(user_id_input)

    if hashed_input in user_data:
        st.success(f"Welcome, {user_data[hashed_input]} 👋")
    else:
        st.error("Invalid User ID.")
